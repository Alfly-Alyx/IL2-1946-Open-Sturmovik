* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.prs text eol=crlf
*.md text eol=lf
*.rtf binary
*.dll binary
*.exe binary
*.wav binary

# Archives volumineuses : stockage Git LFS pour les nouveaux commits.
*.SFS filter=lfs diff=lfs merge=lfs -text
*.sfs filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text

# Fonds de chargement 4K v1.15 : conserver les binaires sans conversion Git.
/Files/gui/Background.tga filter=lfs diff=lfs merge=lfs -text
"/_Game Switcher/Loading Backgrounds/**/*.tga" filter=lfs diff=lfs merge=lfs -text

# Runtime v1.15 verifie octet pour octet : ne pas convertir les fins de ligne.
/Files/3do/Cockpit/CW-21/** -text
/Files/Effects/clouds/* -text
/Files/com/maddox/il2/objects/air.ini -text
/Files/i18n/plane_ru.properties -text
"/_Game Switcher/408m air.ini/Air.ini/air.ini" -text
"/_Game Switcher/409m air.ini/Air.ini/air.ini" -text
/Open_Sturmovik_Switcher.bat text eol=crlf
"/_Game Switcher/409b air.ini/Air.ini/air.ini" -text
/_Game_Enhancements/Mod_AOC_Public/*.txt -text
/Files/presets/sounds/motor.Allison.prs -text
/Files/presets/sounds/motor.Allison_V1700_series.prs -text
/Files/presets/sounds/motor.Allison.start.begin.prs -text
/Files/presets/sounds/motor.Allison.start.end.prs -text
/Files/presets/sounds/motor.Allison_tb.start.begin.prs -text
/Files/presets/sounds/motor.Allison_tb.start.end.prs -text
/Files/presets/sounds/motor.DB-600_Series.start.begin.prs -text
/Files/presets/sounds/motor.DB-600_Series.start.end.prs -text
/Files/presets/sounds/motor.PrattWhitney_R-2800_Series.start.begin.prs -text
/Files/presets/sounds/motor.PrattWhitney_R-2800_Series.start.end.prs -text
/Files/presets/sounds/motor.Rolls-Royce-Merlin.start.begin.prs -text
/Files/presets/sounds/motor.Rolls-Royce-Merlin.start.end.prs -text
/Files/presets/sounds/motor.Sabre.start.begin.prs -text
/Files/presets/sounds/motor.Sabre.start.end.prs -text
/Files/presets/sounds/motor.Sakae.start.begin.prs -text
/Files/presets/sounds/motor.Sakae.start.end.prs -text
# Documents deplaces : preservation de leur contenu original.
/_Documentations/**/*.pdf binary
/_Documentations/**/*.doc binary

# Optional startup rotation: preserve the bytecode and image containers exactly.
"/_Game Switcher/Loading Rotation Patch/Files/*" -text
"/_Game Switcher/Resources/Loading Rotation/**/*.tga" -text
"/_Game Switcher/Resources/Loading Rotation/**/*.png" -text
/test-assets/loading-rotation/*.class -text
/tools/java/OpenSturmovikLoadingRotationPatcher.java text eol=lf
/tools/java/loading-rotation/**/*.java text eol=lf
/tools/java/loading-rotation-tests/**/*.java text eol=lf
/test-assets/loading-rotation/native-first-launch.log -text
