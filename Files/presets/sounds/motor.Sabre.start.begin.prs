[common]
mode         relobj pos
type         mixer
undetune     1

[spl]


[samples]
Sabre_start.wav
xSabre_start.wav

[sample.Sabre_Start.wav]
env 2 8
infinite 0
controls start

[sample.Sabre_start.wav.start]
minlo 0
minhi 0
maxlo 300
maxhi 300
value 4.0
pmin  1.0
pmax  1.0

[sample.xSabre_Start.wav]
env 0
infinite 0
controls dist

[sample.xSabre_start.wav.start]
minlo 0
minhi 0
maxlo 300
maxhi 300
value 4.0
pmin  1.0
pmax  1.0

[sample.xSabre_start.wav.dist]
minlo 0
minhi 0
maxlo 100
maxhi 200
value 4.0
pmin  1.0
pmax  1.0
