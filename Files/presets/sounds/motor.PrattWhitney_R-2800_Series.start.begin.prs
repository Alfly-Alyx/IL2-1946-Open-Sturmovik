[common]
mode         relobj pos
type         mixer
undetune     1

[spl]


[samples]
r2800_start.wav
xr2800_start.wav

[sample.r2800_start.wav]
env 2 8
infinite 1
controls start

[sample.r2800_start.wav.start]
minlo 0
minhi 0
maxlo 300
maxhi 300
value 4.0
pmin  1.0
pmax  1.0

[sample.xr2800_start.wav]
env 0
infinite 1
controls dist

[sample.xr2800_start.wav.start]
minlo 0
minhi 0
maxlo 300
maxhi 300
value 4.0
pmin  1.0
pmax  1.0

[sample.xr2800_start.wav.dist]
minlo 0
minhi 0
maxlo 100
maxhi 200
value 4.0
pmin  1.0
pmax  1.0
