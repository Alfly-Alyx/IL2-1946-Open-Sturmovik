[common]
mode         relobj pos
type         mixer
undetune     1

[spl]


[samples]
sakae_startup.wav
xsakae_startup.wav

[sample.sakae_Startup.wav]
env 2 8
infinite 1
controls start

[sample.sakae_startup.wav.start]
minlo 0
minhi 0
maxlo 300
maxhi 300
value 4.0
pmin  1.0
pmax  1.0

[sample.xsakae_Startup.wav]
env 0
infinite 1
controls dist

[sample.xsakae_startup.wav.start]
minlo 0
minhi 0
maxlo 300
maxhi 300
value 4.0
pmin  1.0
pmax  1.0

[sample.xsakae_startup.wav.dist]
minlo 0
minhi 0
maxlo 100
maxhi 200
value 4.0
pmin  1.0
pmax  1.0
