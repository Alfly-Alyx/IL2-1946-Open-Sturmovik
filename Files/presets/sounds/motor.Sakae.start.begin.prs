[common]
mode         relobj pos
type         mixer
undetune     1

[spl]


[samples]
sakae_start.wav
xsakae_start.wav

[sample.sakae_Start.wav]
env 2 8
infinite 1
controls start

[sample.sakae_start.wav.start]
minlo 0
minhi 0
maxlo 300
maxhi 300
value 4.0
pmin  1.0
pmax  1.0

[sample.xsakae_Start.wav]
env 0
infinite 1
controls dist

[sample.xsakae_start.wav.start]
minlo 0
minhi 0
maxlo 300
maxhi 300
value 4.0
pmin  1.0
pmax  1.0

[sample.xsakae_start.wav.dist]
minlo 0
minhi 0
maxlo 100
maxhi 200
value 4.0
pmin  1.0
pmax  1.0
