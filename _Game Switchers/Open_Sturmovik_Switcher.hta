<!doctype html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9" />
<meta charset="utf-8" />
<title>Open Sturmovik Switcher 1.15</title>
<hta:application applicationname="Open Sturmovik Switcher" border="thin"
  caption="yes" maximizebutton="no" minimizebutton="yes" scroll="no"
  singleinstance="yes" sysmenu="yes" windowstate="normal" />
<style>
html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
body { font-family: Segoe UI, Tahoma, sans-serif; color: #edf3f5; background: #10181d; }
.top { height: 92px; padding: 22px 28px 0 28px; background: #17252d; border-bottom: 1px solid #35505c; }
.title { font-size: 25px; font-weight: 600; letter-spacing: .5px; }
.subtitle { margin-top: 6px; color: #a9bdc6; font-size: 13px; }
.body { padding: 20px 28px; }
.section { margin-bottom: 18px; }
.section-title { color: #83b5c7; font-size: 12px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; margin-bottom: 9px; }
.cards { white-space: nowrap; }
.card { display: inline-block; vertical-align: top; width: 168px; height: 92px; margin-right: 10px; padding: 0; border: 1px solid #3a525e; border-radius: 7px; background: #19272e; color: #eef5f7; cursor: pointer; }
.card:hover { background: #20343d; border-color: #6fa3b7; }
.card input { margin: 15px 7px 0 14px; vertical-align: top; }
.card strong { display: inline-block; margin-top: 12px; font-size: 17px; }
.card small { display: block; margin: 5px 12px 0 38px; color: #a8bbc3; line-height: 15px; white-space: normal; }
.mode { display: inline-block; margin-right: 18px; padding: 8px 0; color: #d7e4e8; }
.mode input { margin-right: 7px; }
select { width: 260px; color: #eef5f7; background: #1c2c34; border: 1px solid #46626f; border-radius: 5px; padding: 7px; }
.notice { height: 40px; margin-top: 6px; padding: 10px 12px; border-left: 3px solid #d59a43; background: #251f16; color: #dbc49d; font-size: 12px; line-height: 18px; }
.actions { margin-top: 18px; text-align: right; }
button { min-width: 115px; margin-left: 8px; padding: 9px 16px; border-radius: 5px; border: 1px solid #54707b; color: #edf4f6; background: #263a43; cursor: pointer; font-weight: 600; }
button.primary { border-color: #5d94a8; background: #2d687d; }
button:hover { background: #35515d; }
button.primary:hover { background: #367d95; }
button:disabled { color: #77888f; background: #202c31; border-color: #33434a; }
#result { display: none; height: 285px; padding: 18px 22px; }
#statusTitle { font-size: 21px; margin-bottom: 12px; }
#log { height: 165px; overflow: auto; padding: 12px; border: 1px solid #344851; background: #0c1215; color: #cfe0e6; font-family: Consolas, monospace; font-size: 12px; white-space: pre-wrap; }
.ok { color: #79c79b; }
.error { color: #e88476; }
</style>
<script language="javascript">
var fso, shell, root, bat, switchRoot;

function init() {
  window.resizeTo(650, 620);
  window.moveTo((screen.availWidth - 650) / 2, (screen.availHeight - 620) / 2);
  fso = new ActiveXObject('Scripting.FileSystemObject');
  shell = new ActiveXObject('WScript.Shell');
  var here = decodeURIComponent(location.pathname).replace(/^\//, '').replace(/\//g, '\\');
  switchRoot = fso.GetParentFolderName(here);
  root = fso.GetParentFolderName(switchRoot);
  bat = fso.BuildPath(root, 'Open_Sturmovik_Switcher.bat');
  var state = fso.BuildPath(switchRoot, 'active-profile.txt');
  if (fso.FileExists(state)) {
    var stream = fso.OpenTextFile(state, 1, false, -2);
    var text = stream.ReadAll();
    stream.Close();
    var match = /label=([^\r\n]+)/.exec(text);
    if (match) document.getElementById('current').innerText = 'Profil actif : ' + match[1];
  }
  updateNotice();
}

function selected(name) {
  var items = document.getElementsByName(name);
  for (var i = 0; i < items.length; i++) if (items[i].checked) return items[i].value;
  return '';
}

function profileNumber() {
  var version = selected('version');
  var mode = selected('mode');
  var base = version == '408' ? 0 : (version == '409b' ? 3 : 6);
  var offset = mode == 'original' ? 1 : (mode == 'standard' ? 2 : 3);
  return base + offset;
}

function updateNotice() {
  var version = selected('version');
  var notice = document.getElementById('notice');
  if (version == '409m') {
    notice.innerText = '4.09m est la cible recommandee pour Open Sturmovik 1.15. Les versions 4.08m et 4.09b sont conservees pour la compatibilite historique et doivent encore etre validees en jeu.';
  } else {
    notice.innerText = 'Profil historique : le switcher installera aussi les SFS et DLL correspondant a cette version. Fermez toujours IL-2 avant le changement.';
  }
}

function applyProfile() {
  if (!fso.FileExists(bat)) {
    showResult(false, 'Le fichier BAT du switcher est introuvable.');
    return;
  }
  var profile = profileNumber();
  var hud = document.getElementById('hud').value;
  document.getElementById('apply').disabled = true;
  document.getElementById('apply').innerText = 'Verification...';
  setTimeout(function () { runSwitch(profile, hud); }, 60);
}

function runSwitch(profile, hud) {
  var temp = fso.GetSpecialFolder(2);
  var log = fso.BuildPath(temp, 'OpenSturmovikSwitcher-' + new Date().getTime() + '.log');
  var command = 'cmd.exe /D /C ""' + bat + '" --apply ' + profile + ' ' + hud + ' > "' + log + '" 2>&1"';
  var code = shell.Run(command, 0, true);
  var text = '';
  if (fso.FileExists(log)) {
    var stream = fso.OpenTextFile(log, 1, false, -2);
    text = stream.ReadAll();
    stream.Close();
    try { fso.DeleteFile(log, true); } catch (ignore) {}
  }
  showResult(code === 0, text || ('Le switcher a retourne le code ' + code + '.'));
}

function showResult(ok, text) {
  document.getElementById('form').style.display = 'none';
  document.getElementById('result').style.display = 'block';
  var title = document.getElementById('statusTitle');
  title.className = ok ? 'ok' : 'error';
  title.innerText = ok ? 'Profil applique avec succes' : 'Le changement a echoue';
  document.getElementById('log').innerText = text;
}

function backToForm() {
  document.getElementById('result').style.display = 'none';
  document.getElementById('form').style.display = 'block';
  document.getElementById('apply').disabled = false;
  document.getElementById('apply').innerText = 'Appliquer';
  init();
}
</script>
</head>
<body onload="init()">
  <div class="top">
    <div class="title">Open Sturmovik Switcher <span style="color:#78aabd">1.15</span></div>
    <div class="subtitle" id="current">Choisissez la version du moteur et le mode de jeu.</div>
  </div>
  <div class="body" id="form">
    <div class="section">
      <div class="section-title">Version du jeu</div>
      <div class="cards">
        <label class="card"><input type="radio" name="version" value="408" onclick="updateNotice()" /><strong>4.08m</strong><small>Reference historique issue du DVD 4.07m et du patch 4.08m.</small></label>
        <label class="card"><input type="radio" name="version" value="409b" onclick="updateNotice()" /><strong>4.09b</strong><small>Version beta historique, distincte de la finale.</small></label>
        <label class="card"><input type="radio" name="version" value="409m" onclick="updateNotice()" checked="checked" /><strong>4.09m</strong><small>Version finale recommandee pour la v1.15.</small></label>
      </div>
    </div>
    <div class="section">
      <div class="section-title">Mode</div>
      <label class="mode"><input type="radio" name="mode" value="standard" checked="checked" />Open Sturmovik</label>
      <label class="mode"><input type="radio" name="mode" value="sixdof" />Open Sturmovik + 6DOF</label>
      <label class="mode"><input type="radio" name="mode" value="original" />Original</label>
    </div>
    <div class="section">
      <div class="section-title">Affichage HUD</div>
      <select id="hud">
        <option value="keep" selected="selected">Conserver le HUD actuel</option>
        <option value="standard">HUD standard</option>
        <option value="immersion">HUD immersion</option>
      </select>
    </div>
    <div class="notice" id="notice"></div>
    <div class="actions">
      <button onclick="window.close()">Fermer</button>
      <button class="primary" id="apply" onclick="applyProfile()">Appliquer</button>
    </div>
  </div>
  <div id="result">
    <div id="statusTitle"></div>
    <div id="log"></div>
    <div class="actions"><button class="primary" onclick="backToForm()">Retour</button><button onclick="window.close()">Fermer</button></div>
  </div>
</body>
</html>
