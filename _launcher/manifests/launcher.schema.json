{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-sturmovik.invalid/schemas/launcher-manifest-v1.json",
  "title": "Open Sturmovik launcher manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "profiles",
    "visualQuality",
    "capabilities",
    "keyMapping",
    "integrity",
    "il2SetupCompatibility",
    "errorReporting"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": {
      "type": "object",
      "required": ["id", "name", "targetVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "targetVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    },
    "visualQuality": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/choice" }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "keyMapping": { "type": "object" },
    "integrity": { "type": "object" },
    "il2SetupCompatibility": {
      "type": "object",
      "required": [
        "replacementFileName",
        "legacyContract",
        "configurationFile",
        "presetCatalogue",
        "transactionalWrites",
        "preserveUnknownKeys"
      ],
      "properties": {
        "replacementFileName": { "const": "il2setup.exe" },
        "legacyContract": { "$ref": "#/$defs/projectPath" },
        "configurationFile": { "const": "conf.ini" },
        "presetCatalogue": { "const": "il2setup.ini" },
        "transactionalWrites": { "const": true },
        "preserveUnknownKeys": { "const": true }
      },
      "additionalProperties": false
    },
    "errorReporting": {
      "type": "object",
      "required": [
        "availability",
        "schema",
        "collectorManifest",
        "logCollector",
        "automaticUploadRequiresConsent",
        "canDisable",
        "canPreview",
        "canDeletePending",
        "includeRawLogs",
        "includeMemoryDumpsAutomatically",
        "transport",
        "githubPermissions"
      ],
      "properties": {
        "availability": { "$ref": "#/$defs/availability" },
        "schema": { "$ref": "#/$defs/projectPath" },
        "collectorManifest": { "$ref": "#/$defs/projectPath" },
        "logCollector": { "$ref": "#/$defs/projectPath" },
        "automaticUploadRequiresConsent": { "const": true },
        "canDisable": { "const": true },
        "canPreview": { "const": true },
        "canDeletePending": { "const": true },
        "includeRawLogs": { "const": false },
        "includeMemoryDumpsAutomatically": { "const": false },
        "transport": { "const": "https-relay-github-app" },
        "githubPermissions": {
          "type": "array",
          "const": ["issues:write"]
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "availability": {
      "type": "string",
      "enum": ["available", "blocked", "research"]
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "file": {
      "type": "object",
      "required": ["source", "target", "size", "sha256"],
      "properties": {
        "source": { "$ref": "#/$defs/projectPath" },
        "target": { "$ref": "#/$defs/projectPath" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["id", "userLabel", "availability", "files"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "userLabel": { "type": "string", "minLength": 1 },
        "availability": { "$ref": "#/$defs/availability" },
        "reason": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/file" }
        }
      },
      "additionalProperties": true
    },
    "choice": {
      "type": "object",
      "required": ["id", "userLabel", "availability"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "userLabel": { "type": "string", "minLength": 1 },
        "availability": { "$ref": "#/$defs/availability" },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": ["id", "category", "userLabel", "availability"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": ["realism", "view", "controls", "visual"]
        },
        "userLabel": { "type": "string", "minLength": 1 },
        "availability": { "$ref": "#/$defs/availability" },
        "reason": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/choice" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
