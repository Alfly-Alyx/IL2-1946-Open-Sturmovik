# Environnements de developpement
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Fichiers generes par Windows et macOS
Thumbs.db
Desktop.ini
.DS_Store

# Fichiers temporaires et journaux locaux
*.tmp
*.temp
*.log
*.stackdump
eventlog.lst
initlog*.lst

# Sauvegardes et caches produits par Open Sturmovik / le chargeur de mods
.open-sturmovik-transaction-*/
.open-sturmovik-cache/
conf.ini.open-sturmovik.bak
~wrapper.cache
~wrapper.cache.*

# Caches d outils
__pycache__/
*.py[cod]
.pytest_cache/

# Rapports et binaires regenerables
build/
test-results/
local-artifacts/
tmp/

# Espace de travail local. Les sources sous WIP/development restent versionnees.
/WIP/*
!/WIP/development/
!/WIP/development/**

# Optional loading rotation: generated by Set-LoadingRotation.ps1 from the tracked package
.open-sturmovik-loading-rotation/
/Files/gui/backgrounds/
/Files/B96FAC8E2C4DDBE0
/Files/F35AD7F42DE76ABC

# Contenu et sorties regenerables de l'installateur Inno Setup
/WIP/development/installer/Payload/
/WIP/development/installer/Output/
/WIP/development/installer/Payload.staging.*/
